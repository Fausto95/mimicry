{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["node"],
    "rootDir": ".",
    "paths": { "react-native": ["./packages/react-native/src/index.ts"] }
  },
  "include": ["packages/*/src/**/*", "packages/*/test/**/*", "tests/**/*", "types/**/*", "vitest.config.ts"],
  "exclude": ["**/node_modules", "examples"]
}
